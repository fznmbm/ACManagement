# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Application Configuration
NEXT_PUBLIC_APP_NAME="Attendance & Curriculum System"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Configuration (REQUIRED)
RESEND_API_KEY=your_resend_api_key
# Email Domain (use your verified Resend domain)
EMAIL_FROM_DOMAIN= www.al-hikmah.org
EMAIL_FROM_NAME="Al Hikmah Institute Crawley"
EMAIL_REPLY_FROM = alhikmahinstitutecrawley@gmail.comSUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# WhatsApp Cloud API (Meta) — server-side only, never NEXT_PUBLIC_
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Parent portal "How to pay" bank details (optional).
# If unset, the finances page tells parents to contact the office.
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_SORT_CODE=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
